{
  "name": "template-converter",
  "version": "1.0.0",
  "description": "灵工发放模版转换工具",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "compare": "tsx tests/tools/compare.mjs",
    "baseline": "tsx tests/tools/baseline.mjs",
    "build:single": "vite build --mode single"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.1/xlsx-0.20.1.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@types/node": "^26.4.1",
    "eslint": "^9.18.0",
    "iconv-lite": "^0.7.3",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.1.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.0.5"
  }
}
